diff --git a/packaging/smoke/windows.ps1 b/packaging/smoke/windows.ps1
new file mode 100644
index 0000000..28537f3
--- /dev/null
+++ b/packaging/smoke/windows.ps1
@@ -0,0 +1,56 @@
+# Smoke test on a Windows runner: silent install -> verify dir + SYSTEM PATH -> uninstall -> verify clean.
+# Usage: powershell -File packaging/smoke/windows.ps1 -Dist dist -ExpectVersion 1.0.81
+param(
+    [Parameter(Mandatory = $true)][string]$Dist,
+    [Parameter(Mandatory = $true)][string]$ExpectVersion
+)
+$ErrorActionPreference = 'Stop'
+$installDir = 'C:\TOOLS\pt'
+
+function Machine-Path { [Environment]::GetEnvironmentVariable('Path', 'Machine') }
+function Path-Has([string]$dir) {
+    $d = $dir.TrimEnd('\').ToLowerInvariant()
+    return @((Machine-Path) -split ';' | Where-Object { $_.TrimEnd('\').ToLowerInvariant() -eq $d }).Count
+}
+function Check([bool]$cond, [string]$msg) {
+    if (-not $cond) { throw "SMOKE FAIL: $msg" }
+    Write-Host "ok: $msg"
+}
+
+$setup = Get-ChildItem -Path $Dist -Filter 'pt-*-windows-amd64-setup.exe' | Select-Object -First 1
+if ($null -eq $setup) { throw "no installer found in $Dist" }
+Write-Host "Installer: $($setup.FullName)"
+
+$before = Machine-Path
+
+# --- install (twice, to prove PATH is not duplicated on upgrade/reinstall)
+foreach ($i in 1, 2) {
+    $p = Start-Process -FilePath $setup.FullName -ArgumentList '/S' -Wait -PassThru
+    Check ($p.ExitCode -eq 0) "silent install #$i exit code 0 (got $($p.ExitCode))"
+}
+Check (Test-Path "$installDir\pt.exe") 'pt.exe installed to C:\TOOLS\pt'
+Check (Test-Path "$installDir\uninstall.exe") 'uninstaller present'
+Check ((Path-Has $installDir) -eq 1) 'C:\TOOLS\pt present exactly once in SYSTEM PATH'
+
+$out = (& "$installDir\pt.exe" --version) | Select-Object -First 1
+Write-Host $out
+Check ($out -eq "PT version $ExpectVersion") "pt.exe --version == $ExpectVersion"
+
+$arp = Get-ItemProperty 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\pt-go' -ErrorAction SilentlyContinue
+Check ($null -ne $arp -and $arp.DisplayVersion -eq $ExpectVersion) 'Add/Remove Programs entry present'
+
+# --- uninstall (_?= makes the uninstaller run synchronously in place)
+$u = Start-Process -FilePath "$installDir\uninstall.exe" -ArgumentList '/S', "_?=$installDir" -Wait -PassThru
+Check ($u.ExitCode -eq 0) "silent uninstall exit code 0 (got $($u.ExitCode))"
+Check (-not (Test-Path "$installDir\pt.exe")) 'pt.exe removed'
+Check ((Path-Has $installDir) -eq 0) 'C:\TOOLS\pt removed from SYSTEM PATH'
+Check ($null -eq (Get-ItemProperty 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\pt-go' -ErrorAction SilentlyContinue)) 'Add/Remove Programs entry removed'
+
+# uninstall.exe stays when run with _?=, clean it up
+Remove-Item "$installDir\uninstall.exe" -Force -ErrorAction SilentlyContinue
+Remove-Item $installDir -Force -ErrorAction SilentlyContinue
+
+# PATH must hold exactly the same entries as before (path.ps1 drops empty segments, so compare entry lists)
+function Entries([string]$p) { @($p -split ';' | Where-Object { $_.Trim() -ne '' } | ForEach-Object { $_.Trim() }) }
+Check (((Entries (Machine-Path)) -join ';') -eq ((Entries $before) -join ';')) 'SYSTEM PATH entries restored to the original list'
+Write-Host 'WINDOWS SMOKE TEST OK'
diff --git a/packaging/windows/path.ps1 b/packaging/windows/path.ps1
new file mode 100644
index 0000000..043b6dd
--- /dev/null
+++ b/packaging/windows/path.ps1
@@ -0,0 +1,52 @@
+# Adds/removes a directory to/from the SYSTEM (machine) PATH.
+#  - Works on the registry value directly, so the existing REG_EXPAND_SZ type and
+#    unexpanded %VARS% are preserved, and there is no 1024-char (NSIS/setx) truncation.
+#  - Idempotent: 'add' never duplicates, 'remove' removes every matching entry.
+#  - Never writes if nothing changed.
+# Usage: powershell -NoProfile -ExecutionPolicy Bypass -File path.ps1 -Action add|remove -Dir C:\TOOLS\pt
+param(
+    [Parameter(Mandatory = $true)][ValidateSet('add', 'remove')][string]$Action,
+    [Parameter(Mandatory = $true)][string]$Dir
+)
+
+$ErrorActionPreference = 'Stop'
+
+function Normalize([string]$s) {
+    return $s.Trim().Trim('"').TrimEnd('\').ToLowerInvariant()
+}
+
+$Dir = $Dir.Trim().TrimEnd('\')
+if ([string]::IsNullOrWhiteSpace($Dir)) { throw 'Dir is empty' }
+$target = Normalize $Dir
+
+$base = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
+    [Microsoft.Win32.RegistryHive]::LocalMachine,
+    [Microsoft.Win32.RegistryView]::Registry64)
+$key = $base.OpenSubKey('SYSTEM\CurrentControlSet\Control\Session Manager\Environment', $true)
+if ($null -eq $key) { throw 'Cannot open the system Environment registry key (run as Administrator)' }
+
+try {
+    $current = [string]$key.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
+    $parts = @($current -split ';' | Where-Object { $_.Trim() -ne '' })
+
+    $has = @($parts | Where-Object { (Normalize $_) -eq $target }).Count -gt 0
+
+    if ($Action -eq 'add') {
+        if ($has) { Write-Host "PATH already contains $Dir"; exit 0 }
+        $parts = @($parts) + $Dir
+        Write-Host "Added $Dir to system PATH"
+    }
+    else {
+        if (-not $has) { Write-Host "PATH does not contain $Dir"; exit 0 }
+        $parts = @($parts | Where-Object { (Normalize $_) -ne $target })
+        Write-Host "Removed $Dir from system PATH"
+    }
+
+    $new = ($parts -join ';')
+    $key.SetValue('Path', $new, [Microsoft.Win32.RegistryValueKind]::ExpandString)
+}
+finally {
+    $key.Close()
+    $base.Close()
+}
+exit 0
diff --git a/packaging/windows/pt.nsi b/packaging/windows/pt.nsi
new file mode 100644
index 0000000..3b42d3d
--- /dev/null
+++ b/packaging/windows/pt.nsi
@@ -0,0 +1,134 @@
+; NSIS installer for pt (Windows, amd64)
+; Installs to C:\TOOLS\pt and adds that directory to the SYSTEM PATH.
+;
+; Build (from repo root, see packaging/build-windows-installer.sh):
+;   makensis -DVERSION=1.0.81 -DBIN=pt.exe -DREPO=. -DOUTFILE=dist\pt-setup.exe packaging\windows\pt.nsi
+
+Unicode true
+ManifestDPIAware true
+SetCompressor /SOLID lzma
+
+!ifndef VERSION
+  !define VERSION "0.0.0"
+!endif
+!ifndef BIN
+  !error "Pass -DBIN=<path to pt.exe>"
+!endif
+!ifndef REPO
+  !define REPO "."
+!endif
+!ifndef OUTFILE
+  !define OUTFILE "pt-${VERSION}-windows-amd64-setup.exe"
+!endif
+
+!define APPNAME     "pt"
+!define PUBLISHER   "Hadi Cahyadi"
+!define URL         "https://github.com/cumulus13/pt-go"
+!define DEFAULT_DIR "C:\TOOLS\pt"
+!define UNINST_KEY  "Software\Microsoft\Windows\CurrentVersion\Uninstall\pt-go"
+
+!include "MUI2.nsh"
+!include "x64.nsh"
+!include "WinMessages.nsh"
+!include "LogicLib.nsh"
+
+Name "${APPNAME} ${VERSION}"
+OutFile "${OUTFILE}"
+InstallDir "${DEFAULT_DIR}"
+RequestExecutionLevel admin
+BrandingText "${APPNAME} ${VERSION}"
+
+!ifdef VI_VERSION
+  VIProductVersion "${VI_VERSION}"
+  VIAddVersionKey "ProductName"     "${APPNAME}"
+  VIAddVersionKey "CompanyName"     "${PUBLISHER}"
+  VIAddVersionKey "FileDescription" "pt installer"
+  VIAddVersionKey "FileVersion"     "${VERSION}"
+  VIAddVersionKey "ProductVersion"  "${VERSION}"
+  VIAddVersionKey "LegalCopyright"  "MIT License"
+!endif
+
+!define MUI_ABORTWARNING
+!define MUI_ICON   "${REPO}\pt.ico"
+!define MUI_UNICON "${REPO}\pt.ico"
+
+!insertmacro MUI_PAGE_WELCOME
+!insertmacro MUI_PAGE_DIRECTORY
+!insertmacro MUI_PAGE_INSTFILES
+!insertmacro MUI_PAGE_FINISH
+!insertmacro MUI_UNPAGE_CONFIRM
+!insertmacro MUI_UNPAGE_INSTFILES
+!insertmacro MUI_LANGUAGE "English"
+
+Function .onInit
+  ${IfNot} ${RunningX64}
+    MessageBox MB_ICONSTOP "This installer requires 64-bit Windows." /SD IDOK
+    Abort
+  ${EndIf}
+  SetRegView 64
+FunctionEnd
+
+Function un.onInit
+  SetRegView 64
+FunctionEnd
+
+; Runs path.ps1 ($0 = add|remove). Result code is checked; failure is reported
+; but is not fatal for the file install.
+!macro RunPathScript ACTION
+  DetailPrint "Updating system PATH (${ACTION})..."
+  nsExec::ExecToLog '"$WINDIR\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\path.ps1" -Action ${ACTION} -Dir "$INSTDIR"'
+  Pop $0
+  ${If} $0 != "0"
+    DetailPrint "PATH update returned: $0"
+    MessageBox MB_ICONEXCLAMATION|MB_OK "Could not update the system PATH automatically (code $0).$\r$\nAdd $INSTDIR to PATH manually if needed." /SD IDOK
+  ${EndIf}
+  SendMessage ${HWND_BROADCAST} ${WM_WININICHANGE} 0 "STR:Environment" /TIMEOUT=5000
+!macroend
+
+Section "Install"
+  SetRegView 64
+  SetOutPath "$INSTDIR"
+  SetOverwrite on
+
+  File /oname=pt.exe "${BIN}"
+  File "${REPO}\pt.yml.example"
+  File "${REPO}\README.md"
+  File "${REPO}\pt.ico"
+  File "${REPO}\VERSION"
+  File "${REPO}\path.ps1"
+
+  WriteUninstaller "$INSTDIR\uninstall.exe"
+
+  !insertmacro RunPathScript add
+
+  ; Add/Remove Programs entry
+  WriteRegStr   HKLM "${UNINST_KEY}" "DisplayName"          "${APPNAME} (clipboard to file tool)"
+  WriteRegStr   HKLM "${UNINST_KEY}" "DisplayVersion"       "${VERSION}"
+  WriteRegStr   HKLM "${UNINST_KEY}" "Publisher"            "${PUBLISHER}"
+  WriteRegStr   HKLM "${UNINST_KEY}" "URLInfoAbout"         "${URL}"
+  WriteRegStr   HKLM "${UNINST_KEY}" "InstallLocation"      "$INSTDIR"
+  WriteRegStr   HKLM "${UNINST_KEY}" "DisplayIcon"          "$INSTDIR\pt.exe"
+  WriteRegStr   HKLM "${UNINST_KEY}" "UninstallString"      '"$INSTDIR\uninstall.exe"'
+  WriteRegStr   HKLM "${UNINST_KEY}" "QuietUninstallString" '"$INSTDIR\uninstall.exe" /S'
+  WriteRegDWORD HKLM "${UNINST_KEY}" "NoModify" 1
+  WriteRegDWORD HKLM "${UNINST_KEY}" "NoRepair" 1
+SectionEnd
+
+Section "Uninstall"
+  SetRegView 64
+
+  !insertmacro RunPathScript remove
+
+  Delete /REBOOTOK "$INSTDIR\pt.exe"
+  Delete /REBOOTOK "$INSTDIR\pt.yml.example"
+  Delete /REBOOTOK "$INSTDIR\README.md"
+  Delete /REBOOTOK "$INSTDIR\pt.ico"
+  Delete /REBOOTOK "$INSTDIR\VERSION"
+  Delete /REBOOTOK "$INSTDIR\path.ps1"
+  Delete /REBOOTOK "$INSTDIR\uninstall.exe"
+
+  ; Only removes the directory if it is empty (user config/backups are left alone)
+  RMDir "$INSTDIR"
+
+  DeleteRegKey HKLM "${UNINST_KEY}"
+SectionEnd
